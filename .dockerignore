# Secrets never enter the build context: the server reads /opt/backend/.env through compose.
# `**/` catches copies in subfolders too, not only at the root.
**/.env*
!.env.example
**/*.pem

# Rebuilt inside the image
node_modules
dist
*.tsbuildinfo

# Not needed to build or run
.git
.github
.husky
.vscode
.idea
.claude
.handoff
coverage
test-results
*.log
.DS_Store
