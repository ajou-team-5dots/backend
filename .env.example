# .env로 복사해 채운다. .env는 커밋하지 않는다. 값은 팀 비밀번호 관리자로만 주고받는다.
# 키 설명, 개발과 운영의 차이: docs/ENV.md

# development | production | test (기본 development)
NODE_ENV=
# HTTP 포트 (기본 3000)
PORT=

# ClickHouse HTTP 주소. 형식: http://<DB 주소>:8123 (계정은 URL에 넣지 않는다)
# 개발: DB 공인 IP, 운영: DB 사설 IP. 이 키만 바꾸면 환경이 바뀐다
CLICKHOUSE_URL=
# 읽기 전용 계정 이름
CLICKHOUSE_USER=
# 비밀
CLICKHOUSE_PASSWORD=
# 데이터베이스 이름
CLICKHOUSE_DB=
# 요청 제한 시간(밀리초, 선택. 기본 10000)
CLICKHOUSE_REQUEST_TIMEOUT_MS=

# 미리 계산 JSON(<이름>.json) 폴더 (선택). 비우면 저장소의 data/precomputed
PRECOMPUTED_DIR=
# 조회 결과 캐시 시간(밀리초, 선택. 기본 3600000 = 1시간)
CACHE_TTL_MS=

# Next 서버(Vercel)가 이 API를 부를 때 x-api-key 헤더로 보내는 키 (비밀)
# 쉼표로 두 개까지(교체용). 한 개는 32자 이상, 만들기: openssl rand -hex 32
# production에서 필수, 개발에서 비우면 검사를 끈다
API_KEYS=
# 적재·배치 뒤 POST /admin/cache/clear를 부를 때 x-revalidate-token 헤더로 보내는 운영 토큰 (비밀)
# 32자 이상, 만들기: openssl rand -hex 32. API 키와 다른 값을 쓴다
# production에서 필수, 개발에서 비우면 이 엔드포인트는 모든 요청을 거부한다
REVALIDATE_TOKEN=
