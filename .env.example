# .env로 복사해 채운다. .env는 커밋하지 않는다. 값은 팀 비밀번호 관리자로만 주고받는다.
# 키 설명, 개발과 운영의 차이: docs/ENV.md

# development | production | test (기본 development)
NODE_ENV=
# HTTP 포트 (기본 3000)
PORT=

# ClickHouse HTTP 주소. 형식: http://<DB 주소>:8123 (계정은 URL에 넣지 않는다)
# 개발: DB 공인 IP, 운영: DB 사설 IP. 이 키만 바꾸면 환경이 바뀐다
CLICKHOUSE_URL=
# 읽기 전용 계정 이름
CLICKHOUSE_USER=
# 비밀
CLICKHOUSE_PASSWORD=
# 데이터베이스 이름
CLICKHOUSE_DB=
# 요청 제한 시간(밀리초, 선택. 기본 10000)
CLICKHOUSE_REQUEST_TIMEOUT_MS=
